# ============================================
# 环境变量与密钥（绝对不入库）
# ============================================
.env
.env.local
.env.*.local
*.key
*.pem
secrets/

# ============================================
# Go 相关
# ============================================
# 编译产物
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go-engine/bin/
go-engine/dist/
dashboard/bin/
watchdog/bin/

# 各服务根目录下意外编译出的裸二进制
services/*/main

# Go workspace
go.work
go.work.sum

# CTP 动态库（仅 Linux 容器内可用，本地不应有）
*.so.*

# ============================================
# Python 相关
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
.venv/
venv/
env/
ENV/

# 包构建产物
build/
dist/
*.egg-info/
*.egg
.eggs/

# uv lock 之外的临时文件
.python-version

# pytest / mypy / ruff 缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Jupyter
.ipynb_checkpoints/

# ============================================
# Docker 相关
# ============================================
# 持久化数据卷（不入库）
data/
volumes/
docker/data/
docker/volumes/

# ============================================
# 日志
# ============================================
logs/
*.log
*.log.*

# ============================================
# IDE / 编辑器
# ============================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================
# Claude Code / AI 工作区
# ============================================
.claude/
.agents/

# ============================================
# 临时与缓存
# ============================================
tmp/
temp/
*.tmp
*.cache
