#!/usr/bin/env bash
# ============================================================
# pre-commit — 提交前自动检测
# 安装：make install-hooks
# ============================================================
set -euo pipefail

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

PASS=0
FAIL=0

check_step() {
    local name="$1"; shift
    echo -n "  [${YELLOW}CHECK${NC}] $name ... "
    if "$@" > /tmp/precommit-check.log 2>&1; then
        echo -e "${GREEN}PASS${NC}"
        PASS=$((PASS + 1))
    else
        echo -e "${RED}FAIL${NC}"
        cat /tmp/precommit-check.log
        FAIL=$((FAIL + 1))
    fi
}

echo ""
echo "========================================="
echo "  arbitrage-system pre-commit checks"
echo "========================================="

# ---- 1. go vet（编译检查） ----
for dir in services/*/; do
    if [ -f "$dir/go.mod" ]; then
        svc=$(basename "$dir")
        check_step "go vet $svc" sh -c "cd '$dir' && go vet ./..."
    fi
done

# ---- 2. golangci-lint（Go lint） ----
if command -v golangci-lint &> /dev/null; then
    for dir in services/*/; do
        if [ -f "$dir/go.mod" ]; then
            svc=$(basename "$dir")
            check_step "golangci-lint $svc" sh -c "cd '$dir' && golangci-lint run ./... 2>&1"
        fi
    done
else
    echo -e "  [${YELLOW}SKIP${NC}] golangci-lint not installed (run: brew install golangci-lint)"
fi

# ---- 3. ruff（Python lint） ----
if command -v ruff &> /dev/null; then
    check_step "ruff llm_scorer" sh -c "cd services/llm_scorer && ruff check . 2>&1"
    check_step "ruff intel_collector" sh -c "cd services/intel_collector && ruff check . 2>&1"
else
    echo -e "  [${YELLOW}SKIP${NC}] ruff not installed (run: pip install ruff)"
fi

# ---- 4. go test（单元测试） ----
for dir in services/*/; do
    if [ -f "$dir/go.mod" ]; then
        svc=$(basename "$dir")
        check_step "go test $svc" sh -c "cd '$dir' && go test ./... -short -count=1 2>&1"
    fi
done

# ---- 5. contracts 变更检测 ----
if git diff --cached --name-only | grep -q '^contracts/.*\.proto$'; then
    echo -e "  [${YELLOW}WARN${NC}] contracts/*.proto changed — remember to run 'make gen'"
fi

echo ""
echo "========================================="
if [ "$FAIL" -eq 0 ]; then
    echo -e "  ${GREEN}✅ 所有检测通过 ($PASS/$PASS)${NC}"
    echo "========================================="
    exit 0
else
    echo -e "  ${RED}❌ $FAIL 项检测失败 ($PASS 通过 / $FAIL 失败)${NC}"
    echo "========================================="
    echo ""
    echo "修复提示："
    echo "  make fix     — 自动修复格式化问题"
    echo "  make check   — 重新运行所有检测"
    echo ""
    exit 1
fi
