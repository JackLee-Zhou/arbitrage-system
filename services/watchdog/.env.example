# watchdog 服务环境变量

# Redis 地址（用于自动发现服务，必填）
REDIS_ADDR=redis:6379

# 巡检间隔
SCRAPE_INTERVAL=5s

# 巡检目标（逗号分隔，仅当 Redis 不可达时作为 fallback）
HEALTHZ_TARGETS=ctp_tick:8081,trading_agent:8081,llm_scorer:5000,orchestrator:8080,db_writer:8081

# 钉钉
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
