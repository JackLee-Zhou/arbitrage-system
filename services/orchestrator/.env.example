# orchestrator 服务环境变量
SERVICE_NAME=orchestrator
HTTP_PORT=8080

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# trading_agent gRPC
TRADING_AGENT_GRPC=trading_agent:9090

# 巡检列表（健康监控用）
HEALTHZ_TARGETS=ctp_tick:8081,trading_agent:8081,llm_scorer:5000

# 交易日历配置（默认甲醇）
TRADING_HOURS=09:00-10:15,10:30-11:30,13:30-15:00,21:00-23:00
HOLIDAYS_FILE=/app/config/holidays_2026.txt

# 操作审计
AUDIT_ENABLED=true

LOG_LEVEL=info
