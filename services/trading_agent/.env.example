# trading_agent 服务环境变量
SERVICE_NAME=trading_agent
HEALTH_PORT=8081
GRPC_PORT=9090

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# InfluxDB
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=changeme
INFLUXDB_ORG=arbitrage

# LLM Scorer（紧急分析用）
LLM_SCORER_URL=http://llm_scorer:5000

# CTP 前置机
CTP_FRONT_ADDR=tcp://180.168.146.187:10130
CTP_BROKER_ID=9999
CTP_USER_ID=your_user_id
CTP_PASSWORD=your_password

# 业务参数
SYMBOL=<YOUR_CONTRACT>
ALPHA=0.2                    # AI 评分权重
ALPHA_BETA_SENTIMENT=0.0     # P3 舆情权重，P1=0
INITIAL_CAPITAL=100000       # 初始资金（人民币）

# 风控参数
MAX_POSITION=2               # 最大持仓手数
DAILY_MAX_LOSS_PCT=0.02      # 日最大亏损 2%
SINGLE_STOP_LOSS_PCT=0.005   # 单笔止损 0.5%

LOG_LEVEL=info
