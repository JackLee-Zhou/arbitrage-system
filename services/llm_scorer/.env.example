# llm_scorer 服务环境变量
SERVICE_NAME=llm_scorer
HTTP_PORT=5000

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# LLM — DeepSeek（主）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# LLM — 智谱 GLM-4（备用熔断）
GLM_API_KEY=xxx
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4

# 评分参数
SCORE_INTERVAL_SEC=300     # 5 分钟评分间隔
SCORE_TTL_SEC=1800         # 评分有效期 30 分钟
SYMBOL=MA2509
