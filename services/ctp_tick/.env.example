# ctp_tick 服务环境变量
SERVICE_NAME=ctp_tick
# 本机可达地址（本地设 localhost，Docker 留空自动用容器名）
SERVICE_HOST=
HEALTH_PORT=8081

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# CTP 前置机
CTP_FRONT_ADDR=tcp://180.168.146.187:10130    # SimNow 测试
# CTP_FRONT_ADDR=tcp://实盘地址                  # 实盘切换
CTP_BROKER_ID=9999
CTP_USER_ID=your_user_id
CTP_PASSWORD=your_password
CTP_APP_ID=simnow_client_test
CTP_AUTH_CODE=0000000000000000

# 关注合约（逗号分隔，空 = 全市场仅落库不分析）
# 启动时 TD API 自动查询全市场期货合约并全部订阅
# 所有合约 tick → write:tick（落库），关注合约额外 → tick:<symbol>（送分析层）
SUBSCRIBE_SYMBOLS=<YOUR_CONTRACTS>

# InfluxDB（合约元数据写入，空置=跳过 InfluxDB 写入）
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=your_influxdb_token
INFLUXDB_ORG=arbitrage

LOG_LEVEL=info
